{
  "name": "fmp-video-player",
  "private": true,
  "version": "0.1.6.1",
  "description": "FMP Video Player",
  "author": "FMP",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "lint": "oxlint",
    "icons": "node scripts/generate-icon.mjs",
    "sync:update": "node scripts/sync-update-json.mjs",
    "dist": "npm run sync:update && npm run icons && npm run build && node scripts/dist.mjs --win nsis",
    "dist:dir": "npm run sync:update && npm run icons && npm run build && node scripts/dist.mjs --win dir"
  },
  "dependencies": {
    "i18next": "^26.3.2",
    "koffi": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "wait-on": "^9.0.10"
  }
}
